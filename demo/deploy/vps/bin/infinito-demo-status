#!/usr/bin/env bash
# What the INFINITO demo is running: address, branch, version, whether it has its key, today's spend.
set -uo pipefail
APP=/opt/infinito-demo
STATE=/var/lib/infinito-demo-deploy
echo "Dirección:  https://$(cat /etc/infinito-demo/host 2>/dev/null)/"
echo "Rama:       $(cat /etc/infinito-demo/branch 2>/dev/null)"
git -C "$APP" log -1 --format='Versión:    %h %s (%cd)' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null
echo "Servicio:   $(systemctl is-active infinito-demo)  ·  revisión automática: $(systemctl is-active infinito-demo-update.timer)"
if grep -q '^OPENAI_API_KEY=.' /etc/infinito-demo/demo.env 2>/dev/null; then
  echo "Clave:      puesta (no se muestra)"
else
  echo "Clave:      falta; la demo enseña los resultados pero no responde. Ponla con infinito-demo-set-key"
fi
status=$(curl -fs --max-time 3 http://127.0.0.1:8400/api/status 2>/dev/null || true)
[ -n "$status" ] && echo "Estado:     $status"
spend=$(cat /var/lib/infinito-demo/spend.json 2>/dev/null || echo '(nada gastado todavía)')
echo "Gasto hoy:  $spend  (límite DEMO_DAILY_BUDGET en /etc/infinito-demo/demo.env)"
[ -s "$STATE/bad" ] && echo "Fallida:    $(cut -c1-7 "$STATE/bad") no arrancó; se espera al siguiente commit"
echo "Últimas actualizaciones automáticas:"
recent=$(journalctl -u infinito-demo-update --no-pager -o short-iso -n 200 2>/dev/null \
  | grep -E 'Actualizando|Instalado|no arranca|no existe|se sigue master' | tail -n 5)
echo "${recent:-(ninguna todavía: GitHub no ha cambiado desde la instalación)}" | sed 's/^/  /'
