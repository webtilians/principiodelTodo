[Unit]
Description=INFINITO public demo (FastAPI) - INFINITO next to a plain memory
Wants=network-online.target
After=network-online.target

[Service]
User=infinito-demo
Group=infinito-demo
WorkingDirectory=/opt/infinito-demo
Environment=DEMO_HOST=127.0.0.1 DEMO_PORT=8400 DEMO_DATA_DIR=/var/lib/infinito-demo DEMO_REQUIRE_KEY=1
Environment=PYTHONPATH=/opt/infinito-demo PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# The OpenAI key, the daily budget and the limits.
EnvironmentFile=/etc/infinito-demo/demo.env
ExecStart=/opt/infinito-demo-venv/bin/python -m demo
Restart=on-failure
RestartSec=5
# Shares one CPU with LAIN, DH Trails, the laboratory and RecipAI: the demo mostly waits on
# OpenAI, and LAIN keeps priority.
Nice=10
CPUWeight=20
IOWeight=10
MemoryHigh=220M
MemoryMax=300M
TasksMax=96
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/infinito-demo

[Install]
WantedBy=multi-user.target
