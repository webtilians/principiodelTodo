# Written by setup.sh into /etc/caddy/sites.d/. Caddy gets and renews the HTTPS certificate.
# No access log on purpose: each person's secret address is in the request path.
__HOST__ {
	# A memory is a few words; the one bigger thing anyone sends is a photo on the memory page, whose own limit is in
	# remote_photos.py and which that page refuses in words. Past this size a person sees only an empty error.
	@photo {
		method POST
		path /memory
		header Content-Type multipart/form-data*
	}
	request_body @photo {
		max_size 64MB
	}
	@rest {
		not {
			method POST
			path /memory
			header Content-Type multipart/form-data*
		}
	}
	request_body @rest {
		max_size 256KB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Public replay of synthetic lab recordings; expose only the two viewer assets.
	redir /security/arena /security/arena/ 308
	@arena path /security/arena/ /security/arena/index.html /security/arena/run.json
	handle @arena {
		root * /opt/infinito-remote/security_lab/arena/viewer
		uri strip_prefix /security/arena
		header Cache-Control "no-cache"
		file_server
	}
	# Interactive landing for investors: the static page in landing/ of this repository, and nothing else of it.
	# It loads nothing from other sites, so its policy allows only its own files.
	redir /landing /landing/ 308
	handle_path /landing/* {
		root * /opt/infinito-remote/landing
		header {
			Cache-Control "no-cache"
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		}
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8500
	}
}
