[Unit]
Description=INFINITO memory over HTTP (MCP) - one sealed memory per person, for ChatGPT, Claude and other apps
Wants=network-online.target
After=network-online.target

[Service]
User=infinito-remote
Group=infinito-remote
WorkingDirectory=/var/lib/infinito-remote
Environment=INFINITO_REMOTE_DIR=/var/lib/infinito-remote PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# The model that finds memories by meaning (semantic.py): 122 MB of RAM once loaded.
Environment=INFINITO_EMBEDDINGS=/opt/infinito-remote-models/potion-multilingual-int8
# The public URL lets people sign in (OAuth needs to name itself); setup.sh writes the host.
# $$ is a literal $ for systemd.
ExecStart=/bin/sh -c 'exec /opt/infinito-remote-venv/bin/infinito-remote serve --port 8500 --url "https://$$(cat /etc/infinito-remote/host)"'
Restart=on-failure
RestartSec=5
# Shares one CPU with LAIN and the other sites; LAIN keeps priority.
Nice=10
CPUWeight=20
IOWeight=10
# With its model loaded the service holds about 330 MB. MemoryHigh well above that: past it the kernel
# throttles every allocation, and with no swap the service hung instead of slowing down.
MemoryHigh=450M
MemoryMax=520M
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/infinito-remote

[Install]
WantedBy=multi-user.target
