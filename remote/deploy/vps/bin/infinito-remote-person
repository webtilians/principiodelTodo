#!/usr/bin/env bash
# Who may use INFINITO's remote memory. Each person gets a private address and their own memory.
#   infinito-remote-person add ana       prints Ana's address, only this once: give it to her privately
#   infinito-remote-person list
#   infinito-remote-person remove ana    the address stops working and Ana's memory is deleted
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Ejecuta como root." >&2; exit 1; }
host=$(cat /etc/infinito-remote/host)
runuser -u infinito-remote -- env -C / INFINITO_REMOTE_DIR=/var/lib/infinito-remote \
  INFINITO_REMOTE_URL="https://$host" /opt/infinito-remote-venv/bin/infinito-remote "$@"
# The server keeps open memories; a restart closes the one just deleted.
[ "${1:-}" = remove ] && systemctl restart infinito-remote
exit 0
