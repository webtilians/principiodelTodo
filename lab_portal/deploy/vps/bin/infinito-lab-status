#!/usr/bin/env bash
# What the INFINITO Laboratory is running: address, branch, installed commit, experiment, last updates.
set -uo pipefail
APP=/opt/infinito-lab
STATE=/var/lib/infinito-lab-deploy
echo "Dirección:  https://$(cat /etc/infinito-lab/host 2>/dev/null)/"
echo "Rama:       $(cat /etc/infinito-lab/branch 2>/dev/null)"
git -C "$APP" log -1 --format='Versión:    %h %s (%cd)' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null
echo "Servicio:   $(systemctl is-active infinito-lab)  ·  revisión automática: $(systemctl is-active infinito-lab-update.timer)"
if pgrep -u infinito-lab -f 'lab_portal\.worker' >/dev/null; then
  echo "Ahora:      hay un experimento en marcha"
else
  echo "Ahora:      sin experimentos en marcha"
fi
[ -s "$STATE/waiting" ] && echo "En espera:  $(cut -c1-7 "$STATE/waiting") se instalará al terminar el experimento"
[ -s "$STATE/bad" ] && echo "Fallida:    $(cut -c1-7 "$STATE/bad") no arrancó; se espera al siguiente commit"
echo "Últimas actualizaciones automáticas:"
recent=$(journalctl -u infinito-lab-update --no-pager -o short-iso -n 200 2>/dev/null \
  | grep -E 'Actualizando|Instalado|no arranca|experimento en marcha|no existe' | tail -n 5)
echo "${recent:-(ninguna todavía: GitHub no ha cambiado desde la instalación)}" | sed 's/^/  /'
