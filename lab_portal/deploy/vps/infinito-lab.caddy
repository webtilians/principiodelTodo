# Written by setup.sh into /etc/caddy/sites.d/. Caddy gets and renews the HTTPS certificate.
__HOST__ {
	encode gzip
	# F9 model bundles are bounded and validated by the authenticated worker API.
	@f9_upload path /api/worker/jobs/*/finish
	request_body @f9_upload {
		max_size 64MB
	}
	@ordinary not path /api/worker/jobs/*/finish
	request_body @ordinary {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	reverse_proxy 127.0.0.1:8200
}
